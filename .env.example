# Backend config for LOCAL runs (cmd/devserver). Copy to .env and fill in.
# In dev/prod these come from SAM parameters; secrets come from SSM, never from here.

APP_NAME=gp
APP_ENV=local
PLATFORM_NAME=NearShop
PLATFORM_DOMAIN=nearshop.lk
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8080
IMG_BASE_URL=https://img.nearshop.lk
SUPPORT_PHONE=+94770000000
SUPER_ADMIN_EMAILS=admin@example.com
ADMIN_ALERT_PHONE=+94770000000
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
CART_API_BASE=https://api-dev.cart.example.com/v1
SSM_PREFIX=/gp/local
SMS_API_URL=
SMS_SENDER_ID=
SMS_DAILY_CAP=50
FEATURE_SINGLE_SHOP=true
FEATURE_WHATSAPP=false
FEATURE_MANUAL_PAYMENT=true
LOG_LEVEL=debug

# ---- local only (refused when APP_ENV is dev or prod) ----
DATABASE_URL=postgresql://app_rw:app_rw@localhost:5432/gp?sslmode=disable
SECRETS_FROM_ENV=true
SECRET_JWT_KEY=replace-with-openssl-rand-base64-32
SECRET_ENC_KEY=replace-with-openssl-rand-base64-32
SECRET_OTP_PEPPER=replace-with-openssl-rand-base64-32
SECRET_IP_PEPPER=replace-with-openssl-rand-base64-32
SECRET_CART_PLATFORM_KEY=plk_test_replace_me
SECRET_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
