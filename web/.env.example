# Frontend build-time config for Next.js. EVERYTHING here is public (shipped to browsers).
# Never put a secret in a NEXT_PUBLIC_ variable. CI fails on any NEXT_PUBLIC_ name not listed here.

NEXT_PUBLIC_API_BASE=http://localhost:8080/v1
NEXT_PUBLIC_CART_API_BASE=https://api-dev.cart.example.com/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
NEXT_PUBLIC_MAPS_KEY=replace-with-referrer-restricted-browser-key
# Cloudflare's always-pass test site key for local work
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_IMG_BASE=https://img.nearshop.lk
NEXT_PUBLIC_PLATFORM_NAME=NearShop
NEXT_PUBLIC_PLATFORM_DOMAIN=nearshop.lk
NEXT_PUBLIC_ACCENT=#0e7c66
